{
 "version": 1,
 "description": "Static security rules for cc-catalog security.py. Patterns are Python regexes matched per line (case-insensitive unless case_sensitive). Severity: info < review < high. Kinds: script, hooks (hook configs), settings (.claude/settings*.json), manifest (plugin.json/.mcp.json), md_instr (SKILL.md/agents/commands), md_doc (other markdown). prefilter: lowercase substrings, at least one must occur in the file before the rule's regexes run.",
 "context": {
  "test_path": "(?:^|/)(?:tests?|__tests__|spec|specs|fixtures?|examples?|samples?|demos?|testdata|test-data|datasets?|corpus|cve-replay|mocks?|evals?|benchmarks?)(?:/|$)|\\.(?:test|spec)\\.[a-z]+$|(?:^|/)test_[^/]+$",
  "doc_words": "\\b(?:never|don'?t|do not|avoid|dangerous|destructive|malicious|attack(?:er|s)?|detect(?:s|ed|ion)?|flag(?:s|ged)?|block(?:s|ed|ing)?|den(?:y|ies|ied)|forbid(?:den)?|prohibit(?:ed)?|warn(?:ing)?|risk(?:y|s)?|unsafe|vulnerab\\w*|exploit\\w*|red.flag|anti-?pattern|insecure|prevent\\w*|refuse|reject\\w*|suspicious|threat\\w*|injection|watch for|look for|such as|e\\.g\\.|example|bad:|wrong:|instead of|scan\\w*|audit\\w*|checks? for|catch(?:es)?|guard\\w*|exfiltrat\\w*|backdoor|poison\\w*|jailbreak\\w*|sanitiz\\w*|harden\\w*)\\b|\\u7981\\u6b62|\\u5371\\u967a|\\u7d76\\u5bfe|\\u4e0d\\u53ef|\\uae08\\uc9c0|\\uc704\\ud5d8|\\ucc28\\ub2e8|\\u5371\\u9669|\\u963b\\u6b62|\\u274c|\\U0001F6AB|\\u26a0",
  "doc_window": 2,
  "doc_heading": "\\b(?:never|don'?t|do not|avoid|dangerous|destructive|forbidden|forbid|prohibited|blocked|blocklist|denylist|deny|disallowed|banned|red flags?|anti-?patterns?|risky|unsafe|malicious|threats?|attacks?|detection|indicators?|guardrails?|safety|what not to)\\b|禁止|危険|금지|危险",
  "guard_words": "\\b(?:dangerous|danger|block(?:ed|list|ing)?|den(?:y|ied|ylist)|forbid\\w*|prevent\\w*|protect\\w*|guard\\w*|blacklist|patterns?|regex\\w*|re\\.compile|RegExp|match(?:es|ing)?|unsafe|reject\\w*|disallow\\w*|warn\\w*|destructive|risky|prohibit\\w*|BLOCKED|safety|detect\\w*|check\\w*|rule\\w*|signature\\w*|indicator\\w*)\\b|=~|\\bgrep\\b|\\bcase\\b",
  "guard_file": "permissionDecision[\\\"']?\\s*[:=]\\s*[\\\"']?(?:deny|ask)|[\\\"']decision[\\\"']\\s*:\\s*[\\\"']block|exit\\s+2\\b|sys\\.exit\\(\\s*2\\s*\\)|process\\.exit\\(\\s*2\\s*\\)|\\bBLOCKED\\b|dangerous[_ ]?(?:patterns|commands)",
  "security_terms": [
   "security",
   "vulnerab",
   "malicious",
   "exploit",
   "injection",
   "attack",
   "cwe-",
   "owasp",
   "threat",
   "pentest",
   "penetration",
   "red team",
   "red-team",
   "sanitiz",
   "cve-",
   "xss",
   "ssrf",
   "exfiltrat",
   "backdoor",
   "audit"
  ],
  "security_terms_min": 4,
  "quoted_citation": "[\\\"'`\\u201c\\u2018]"
 },
 "rules": [
  {
   "id": "rce-pipe-shell",
   "category": "remote-code-execution",
   "description": "Downloads a script and pipes it straight into a shell/interpreter (curl|sh).",
   "severity": "high",
   "severity_by_kind": {
    "script": "review",
    "md_instr": "info",
    "md_doc": "info"
   },
   "scope": [
    "script",
    "hooks",
    "settings",
    "manifest",
    "md_instr",
    "md_doc"
   ],
   "escalate": {
    "pattern": "\\bhttp://(?!localhost|127\\.|0\\.0\\.0\\.0)|https?://\\d{1,3}(?:\\.\\d{1,3}){3}|\\bsudo\\b|bit\\.ly/|tinyurl\\.com|is\\.gd/|gist\\.githubusercontent\\.com|pastebin\\.com|workers\\.dev|ngrok|trycloudflare\\.com",
    "window": 0,
    "severity": "review",
    "note": "md instructions: plain https vendor installers stay info; insecure/odd hosts or sudo raise to review"
   },
   "patterns": [
    "\\b(?:curl|wget)\\b[^|\\n;]*\\|\\s*(?:sudo\\s+(?:-\\S+\\s+)*)?(?:env\\s+\\S+=\\S+\\s+)*(?:(?:ba|z|da|k)?sh|python[0-9.]*|node|perl|ruby|php|bash)\\b",
    "\\b(?:ba|z|da|k)?sh\\s+(?:-\\w+\\s+)*-c\\s+[\\\"']?\\$\\(\\s*(?:curl|wget)\\b",
    "\\b(?:ba|z|da|k)?sh\\s+<\\(\\s*(?:curl|wget)\\b",
    "\\bsource\\s+<\\(\\s*(?:curl|wget)\\b"
   ],
   "not_patterns": [
    "\\|\\s*(?:(?:ba|z|da|k)?sh)\\s+-n\\b",
    "\\|\\s*(?:python[0-9.]*|node|perl|ruby|php)\\s+-[ce]\\b",
    "\\|\\s*python[0-9.]*\\s+-m\\s+json\\.tool"
   ],
   "allowlist": {
    "severity": "info",
    "patterns": [
     "(?:https?://)?(?:www\\.)?(?:sh\\.rustup\\.rs|rustup\\.rs|astral\\.sh/(?:uv|ruff)|bun\\.sh/install|bun\\.com/install|deno\\.land/install|deno\\.land/x/install|deno\\.com/install|raw\\.githubusercontent\\.com/nvm-sh/nvm/|raw\\.githubusercontent\\.com/Homebrew/install/|claude\\.ai/install\\.(?:sh|ps1|cmd)|get\\.pnpm\\.io|install\\.python-poetry\\.org|get\\.docker\\.com|ollama\\.com/install\\.sh|starship\\.rs/install\\.sh|fnm\\.vercel\\.app/install|get\\.volta\\.sh|get\\.sdkman\\.io|pyenv\\.run|mise\\.run|mise\\.jdx\\.dev|raw\\.githubusercontent\\.com/helm/helm/|cli\\.github\\.com|sh\\.flutter\\.dev|get\\.rvm\\.io|install\\.determinate\\.systems|nixos\\.org/nix/install|tailscale\\.com/install\\.sh|opencode\\.ai/install|cursor\\.com/install|gh\\.io/copilot-install|aka\\.ms/install-|dot\\.net/v1/dotnet-install|dotnet\\.microsoft\\.com/download/dotnet/scripts|chocolatey\\.org/install|get\\.scoop\\.sh|community\\.chocolatey\\.org/install|supabase\\.com|fly\\.io/install|vercel\\.com/install|raw\\.githubusercontent\\.com/anthropics/|get\\.acme\\.sh|sh\\.rustup\\.rs|install\\.duckdb\\.org|cli\\.doppler\\.com|rclone\\.org/install\\.sh|get\\.k3s\\.io|raw\\.githubusercontent\\.com/ohmyzsh/)"
    ]
   },
   "prefilter": [
    "curl",
    "wget"
   ]
  },
  {
   "id": "rce-powershell-iex",
   "category": "remote-code-execution",
   "description": "PowerShell downloads and executes remote code (iex/irm/iwr/DownloadString).",
   "severity": "high",
   "severity_by_kind": {
    "script": "review",
    "md_instr": "info",
    "md_doc": "info"
   },
   "scope": [
    "script",
    "hooks",
    "settings",
    "manifest",
    "md_instr",
    "md_doc"
   ],
   "escalate": {
    "pattern": "\\bhttp://(?!localhost|127\\.|0\\.0\\.0\\.0)|https?://\\d{1,3}(?:\\.\\d{1,3}){3}|\\bsudo\\b|bit\\.ly/|tinyurl\\.com|is\\.gd/|gist\\.githubusercontent\\.com|pastebin\\.com|workers\\.dev|ngrok|trycloudflare\\.com",
    "window": 0,
    "severity": "review",
    "note": "md instructions: plain https vendor installers stay info; insecure/odd hosts or sudo raise to review"
   },
   "patterns": [
    "\\b(?:iex|Invoke-Expression)\\b\\s*\\(?\\s*\\(?\\s*(?:iwr|irm|Invoke-WebRequest|Invoke-RestMethod|\\(?New-Object\\s+(?:System\\.)?Net\\.WebClient)",
    "\\b(?:iwr|irm|Invoke-WebRequest|Invoke-RestMethod)\\b[^|\\n]*\\|\\s*(?:iex|Invoke-Expression)\\b",
    "\\.DownloadString\\([^)]*\\)[^\\n]*\\|\\s*(?:iex|Invoke-Expression)\\b",
    "\\b(?:iex|Invoke-Expression)\\b[^\\n]*\\.DownloadString\\("
   ],
   "allowlist": {
    "severity": "info",
    "patterns": [
     "(?:https?://)?(?:www\\.)?(?:sh\\.rustup\\.rs|rustup\\.rs|astral\\.sh/(?:uv|ruff)|bun\\.sh/install|bun\\.com/install|deno\\.land/install|deno\\.land/x/install|deno\\.com/install|raw\\.githubusercontent\\.com/nvm-sh/nvm/|raw\\.githubusercontent\\.com/Homebrew/install/|claude\\.ai/install\\.(?:sh|ps1|cmd)|get\\.pnpm\\.io|install\\.python-poetry\\.org|get\\.docker\\.com|ollama\\.com/install\\.sh|starship\\.rs/install\\.sh|fnm\\.vercel\\.app/install|get\\.volta\\.sh|get\\.sdkman\\.io|pyenv\\.run|mise\\.run|mise\\.jdx\\.dev|raw\\.githubusercontent\\.com/helm/helm/|cli\\.github\\.com|sh\\.flutter\\.dev|get\\.rvm\\.io|install\\.determinate\\.systems|nixos\\.org/nix/install|tailscale\\.com/install\\.sh|opencode\\.ai/install|cursor\\.com/install|gh\\.io/copilot-install|aka\\.ms/install-|dot\\.net/v1/dotnet-install|dotnet\\.microsoft\\.com/download/dotnet/scripts|chocolatey\\.org/install|get\\.scoop\\.sh|community\\.chocolatey\\.org/install|supabase\\.com|fly\\.io/install|vercel\\.com/install|raw\\.githubusercontent\\.com/anthropics/|get\\.acme\\.sh|sh\\.rustup\\.rs|install\\.duckdb\\.org|cli\\.doppler\\.com|rclone\\.org/install\\.sh|get\\.k3s\\.io|raw\\.githubusercontent\\.com/ohmyzsh/)"
    ]
   },
   "prefilter": [
    "iex",
    "invoke-expression"
   ]
  },
  {
   "id": "rce-eval-download",
   "category": "remote-code-execution",
   "description": "Evaluates content fetched from the network (eval $(curl), exec(requests.get), eval(await fetch)).",
   "severity": "high",
   "severity_by_kind": {
    "script": "review",
    "md_instr": "info",
    "md_doc": "info"
   },
   "scope": [
    "script",
    "hooks",
    "settings",
    "manifest",
    "md_instr",
    "md_doc"
   ],
   "escalate": {
    "pattern": "\\bhttp://(?!localhost|127\\.|0\\.0\\.0\\.0)|https?://\\d{1,3}(?:\\.\\d{1,3}){3}|\\bsudo\\b|bit\\.ly/|tinyurl\\.com|is\\.gd/|gist\\.githubusercontent\\.com|pastebin\\.com|workers\\.dev|ngrok|trycloudflare\\.com",
    "window": 0,
    "severity": "review",
    "note": "md instructions: plain https vendor installers stay info; insecure/odd hosts or sudo raise to review"
   },
   "patterns": [
    "\\beval\\s+[\\\"']?\\$\\(\\s*(?:curl|wget)\\b",
    "\\bexec\\s*\\(\\s*(?:requests\\.get|urllib\\.request\\.urlopen|urlopen|httpx\\.get)\\b",
    "\\beval\\s*\\(\\s*(?:await\\s+)?\\(?\\s*(?:await\\s+)?(?:fetch|axios\\.get|got)\\s*\\(",
    "\\bnew\\s+Function\\s*\\([^)]*(?:await\\s+)?(?:fetch|axios)\\s*\\("
   ],
   "allowlist": {
    "severity": "info",
    "patterns": [
     "(?:https?://)?(?:www\\.)?(?:sh\\.rustup\\.rs|rustup\\.rs|astral\\.sh/(?:uv|ruff)|bun\\.sh/install|bun\\.com/install|deno\\.land/install|deno\\.land/x/install|deno\\.com/install|raw\\.githubusercontent\\.com/nvm-sh/nvm/|raw\\.githubusercontent\\.com/Homebrew/install/|claude\\.ai/install\\.(?:sh|ps1|cmd)|get\\.pnpm\\.io|install\\.python-poetry\\.org|get\\.docker\\.com|ollama\\.com/install\\.sh|starship\\.rs/install\\.sh|fnm\\.vercel\\.app/install|get\\.volta\\.sh|get\\.sdkman\\.io|pyenv\\.run|mise\\.run|mise\\.jdx\\.dev|raw\\.githubusercontent\\.com/helm/helm/|cli\\.github\\.com|sh\\.flutter\\.dev|get\\.rvm\\.io|install\\.determinate\\.systems|nixos\\.org/nix/install|tailscale\\.com/install\\.sh|opencode\\.ai/install|cursor\\.com/install|gh\\.io/copilot-install|aka\\.ms/install-|dot\\.net/v1/dotnet-install|dotnet\\.microsoft\\.com/download/dotnet/scripts|chocolatey\\.org/install|get\\.scoop\\.sh|community\\.chocolatey\\.org/install|supabase\\.com|fly\\.io/install|vercel\\.com/install|raw\\.githubusercontent\\.com/anthropics/|get\\.acme\\.sh|sh\\.rustup\\.rs|install\\.duckdb\\.org|cli\\.doppler\\.com|rclone\\.org/install\\.sh|get\\.k3s\\.io|raw\\.githubusercontent\\.com/ohmyzsh/)"
    ]
   },
   "prefilter": [
    "eval",
    "exec",
    "function"
   ]
  },
  {
   "id": "destructive-rm-root-home",
   "category": "destructive",
   "description": "Recursive delete of the filesystem root or the home directory.",
   "severity": "high",
   "severity_by_kind": {
    "md_instr": "review",
    "md_doc": "review"
   },
   "scope": [
    "script",
    "hooks",
    "settings",
    "manifest",
    "md_instr",
    "md_doc"
   ],
   "patterns": [
    "\\brm\\s+(?:-[a-zA-Z]+\\s+)*-[a-zA-Z]*[rR][a-zA-Z]*\\s+(?:-[a-zA-Z-]+\\s+)*[\\\"']?(?:/|/\\*|~|~/|~/\\*|\\$(?-i:HOME)/?|\\$\\{(?-i:HOME)\\}/?|\\$(?-i:HOME)/\\*|\\$\\{(?-i:HOME)\\}/\\*)[\\\"']?(?=\\s*(?:$|[;&|)`]|#))",
    "--no-preserve-root\\b",
    "\\bshutil\\.rmtree\\(\\s*(?:[\\\"'](?:/|~)[\\\"']|os\\.path\\.expanduser\\(\\s*[\\\"']~/?[\\\"']\\s*\\)|Path\\.home\\(\\)|os\\.environ\\[[\\\"']HOME[\\\"']\\])\\s*[,)]",
    "\\bRemove-Item\\s+(?:-Path\\s+)?[\\\"']?(?:C:\\\\\\\\?|\\$env:USERPROFILE\\\\?|\\$HOME|~)[\\\"']?\\s+[^\\n]*-Recurse",
    "\\brd\\s+/s\\s+/q\\s+[A-Za-z]:\\\\?(?:\\s|$)",
    "\\bfs\\.(?:rmSync|rm)\\(\\s*(?:os\\.homedir\\(\\)|[\\\"']/[\\\"'])\\s*,\\s*\\{[^}]*recursive"
   ],
   "not_patterns": [
    "rm\\s+-[a-zA-Z]*\\s+/(?:tmp|var|usr|opt)\\b"
   ],
   "prefilter": [
    "rm ",
    "rm\t",
    "no-preserve-root",
    "rmtree",
    "remove-item",
    "rd /s",
    "rmsync",
    "fs.rm("
   ]
  },
  {
   "id": "destructive-disk",
   "category": "destructive",
   "description": "Raw disk / filesystem destruction (dd to a device, mkfs, format a drive, fork bomb).",
   "severity": "high",
   "scope": [
    "script",
    "hooks",
    "settings",
    "manifest",
    "md_instr",
    "md_doc"
   ],
   "patterns": [
    "\\bdd\\s+[^\\n]*\\bof=/dev/(?:sd[a-z]|nvme\\d|disk\\d|hd[a-z]|xvd[a-z]|mmcblk\\d|rdisk\\d)",
    "\\bmkfs(?:\\.\\w+)?\\s+(?:-\\S+\\s+)*/dev/",
    "\\bformat(?:\\.com)?\\s+[A-Za-z]:\\s*/[qQyY]",
    ":\\(\\)\\s*\\{\\s*:\\|:&\\s*\\};:"
   ],
   "prefilter": [
    "dd ",
    "mkfs",
    "format",
    ":()"
   ]
  },
  {
   "id": "destructive-chmod-777",
   "category": "destructive",
   "description": "Recursive world-writable permissions (chmod -R 777).",
   "severity": "review",
   "scope": [
    "script",
    "hooks",
    "settings",
    "manifest",
    "md_instr",
    "md_doc"
   ],
   "patterns": [
    "\\bchmod\\s+(?:-\\w+\\s+)*-[a-zA-Z]*R[a-zA-Z]*\\s+(?:-\\w+\\s+)*(?:0?777|a\\+rwx|ugo\\+rwx)\\b"
   ],
   "escalate": {
    "pattern": "\\bchmod\\s+[^\\n]*\\s(?:/|~|\\$HOME)\\s*$",
    "window": 0,
    "severity": "high"
   },
   "prefilter": [
    "chmod"
   ]
  },
  {
   "id": "destructive-force-push-main",
   "category": "destructive",
   "description": "Force-pushes to main/master.",
   "severity": "review",
   "scope": [
    "script",
    "hooks",
    "settings",
    "manifest",
    "md_instr",
    "md_doc"
   ],
   "patterns": [
    "\\bgit\\s+push\\b[^\\n]*(?:--force(?!-with-lease)\\b|\\s-f\\b)[^\\n]*\\b(?:main|master)\\b",
    "\\bgit\\s+push\\b[^\\n]*\\b(?:origin\\s+)?\\+(?:main|master)\\b",
    "\\bgit\\s+push\\b[^\\n]*\\b(?:main|master)\\b[^\\n]*(?:--force(?!-with-lease)\\b|\\s-f\\b)"
   ],
   "prefilter": [
    "push"
   ]
  },
  {
   "id": "exfil-secrets-upload",
   "category": "exfiltration",
   "description": "Sends environment variables, SSH/AWS keys or credential files to a remote host.",
   "severity": "high",
   "severity_by_kind": {
    "md_doc": "review"
   },
   "scope": [
    "script",
    "hooks",
    "settings",
    "manifest",
    "md_instr",
    "md_doc"
   ],
   "patterns": [
    "\\b(?:curl|wget)\\b[^\\n]*(?:-d|--data(?:-binary|-raw|-urlencode)?|-F|--form|-T|--upload-file|--post-data|--post-file)[=\\s][^\\n]*(?:\\$\\(\\s*(?:env|printenv|set)\\s*\\)|`(?:env|printenv)`|~/\\.ssh/|\\$HOME/\\.ssh/|~/\\.aws/|\\$HOME/\\.aws/|\\bid_(?:rsa|ed25519|ecdsa|dsa)\\b(?!\\.pub)|\\.aws/credentials|/etc/shadow|\\.netrc|\\.git-credentials)",
    "\\b(?:env|printenv)\\s*\\|\\s*(?:curl|wget|nc|ncat|netcat)\\b",
    "\\bcat\\s+[^\\n|]*(?:~/\\.ssh/|\\$HOME/\\.ssh/|\\.aws/credentials|\\.netrc|\\.git-credentials)[^\\n|]*\\|\\s*(?:curl|wget|nc|ncat|netcat|base64)\\b",
    "\\b(?:fetch|axios\\.post|axios|got\\.post|request\\.post|https?\\.request)\\s*\\([^\\n]*JSON\\.stringify\\(\\s*process\\.env\\s*\\)",
    "\\brequests\\.(?:post|put)\\([^\\n]*(?:dict\\(\\s*os\\.environ\\s*\\)|os\\.environ(?![\\.\\[])\\b|json\\.dumps\\(\\s*(?:dict\\()?\\s*os\\.environ)",
    "\\b(?:pbpaste|xclip\\s+-o|xsel\\s+(?:-\\w+\\s+)*-o|Get-Clipboard)\\b[^\\n]*\\|\\s*(?:curl|wget|nc|ncat)\\b"
   ],
   "prefilter": [
    "curl",
    "wget",
    "env",
    "fetch",
    "axios",
    "got.",
    "request",
    "pbpaste",
    "xclip",
    "xsel",
    "get-clipboard"
   ]
  },
  {
   "id": "exfil-reverse-shell",
   "category": "exfiltration",
   "description": "Reverse shell / raw TCP shell to a remote host.",
   "severity": "high",
   "severity_by_kind": {
    "md_doc": "review"
   },
   "scope": [
    "script",
    "hooks",
    "settings",
    "manifest",
    "md_instr",
    "md_doc"
   ],
   "patterns": [
    "\\b(?:ba)?sh\\s+-i\\s+>&\\s*/dev/tcp/",
    "\\b(?:nc|ncat|netcat)\\b[^\\n]*\\s-e\\s+/bin/(?:ba)?sh\\b",
    "\\bsocket\\.socket\\([^\\n]*\\)[^\\n]*;\\s*[^\\n]*os\\.dup2\\("
   ],
   "prefilter": [
    "/dev/tcp",
    "nc ",
    "ncat",
    "netcat",
    "socket"
   ]
  },
  {
   "id": "exfil-webhook-host",
   "category": "exfiltration",
   "description": "Hard-coded request-catcher / paste / tunnel endpoint commonly used to receive exfiltrated data.",
   "severity": "review",
   "severity_by_kind": {
    "md_instr": "info",
    "md_doc": "info"
   },
   "scope": [
    "script",
    "hooks",
    "settings",
    "manifest",
    "md_instr",
    "md_doc"
   ],
   "patterns": [
    "(?:webhook\\.site|requestbin\\.(?:com|net)|\\.m\\.pipedream\\.net|pipedream\\.net|\\.oast\\.(?:fun|me|pro|live|site|online)|interact\\.sh|burpcollaborator\\.net|canarytokens\\.com|ngrok(?:-free)?\\.(?:io|app|dev)|pastebin\\.com/api|transfer\\.sh|0x0\\.st|hastebin\\.com|termbin\\.com|requestcatcher\\.com|beeceptor\\.com|hookbin\\.com)"
   ],
   "prefilter": [
    "webhook.site",
    "requestbin",
    "pipedream",
    "oast.",
    "interact.sh",
    "burpcollaborator",
    "canarytokens",
    "ngrok",
    "pastebin",
    "transfer.sh",
    "0x0.st",
    "hastebin",
    "termbin",
    "requestcatcher",
    "beeceptor",
    "hookbin"
   ]
  },
  {
   "id": "exfil-chat-webhook",
   "category": "exfiltration",
   "description": "Hard-coded Discord/Slack/Telegram webhook with a real token (data goes to the author's channel).",
   "severity": "review",
   "scope": [
    "script",
    "hooks",
    "settings",
    "manifest",
    "md_instr",
    "md_doc"
   ],
   "patterns": [
    "discord(?:app)?\\.com/api/webhooks/\\d{15,}/[\\w-]{30,}",
    "hooks\\.slack\\.com/(?:services|workflows|triggers)/T[A-Z0-9]{6,}/[A-Z0-9]{6,}/[A-Za-z0-9]{12,}",
    "api\\.telegram\\.org/bot\\d{6,}:[\\w-]{30,}"
   ],
   "case_sensitive": true,
   "prefilter": [
    "discord",
    "hooks.slack",
    "api.telegram"
   ]
  },
  {
   "id": "cred-ssh-cloud-keys",
   "category": "credential-access",
   "description": "Reads SSH private keys, cloud or package-registry credential files.",
   "severity": "review",
   "severity_by_kind": {
    "md_doc": "info"
   },
   "scope": [
    "script",
    "hooks",
    "settings",
    "manifest",
    "md_instr",
    "md_doc"
   ],
   "patterns": [
    "(?:~|\\$HOME|\\$\\{HOME\\}|homedir\\(\\)[^\\n]{0,20}|expanduser\\([\\\"']~)/\\.ssh/(?:id_\\w+|identity)\\b(?!\\.pub)",
